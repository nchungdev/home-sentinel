# Address the agents use to reach this NAS (IP or hostname on the LAN)
NAS_HOST=192.168.1.10
# Shared bearer token for the MCP endpoints: openssl rand -hex 24
MCP_TOKEN=
# Limit the published port to one interface, e.g. the LAN or Tailscale IP
MCP_BIND=0.0.0.0

# Services as seen from inside the container (the NAS host is host.docker.internal)
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
SONARR_URL=http://host.docker.internal:8989
SONARR_API_KEY=
RADARR_URL=http://host.docker.internal:7878
RADARR_API_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_API_KEY=
